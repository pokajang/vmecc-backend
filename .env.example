# Local development template only.
# For production, start from .env.production.example and keep real secrets server-side.
APP_NAME=VMECC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vmecc
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
PUBLIC_UPLOADS_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_REMEMBER_DAYS=30

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
LEAVE_EMAIL_ENABLED=false
WORKFLOW_EMAIL_ENABLED=false
WORKFLOW_EMAIL_MODULE_LEAVE=false
WORKFLOW_EMAIL_MODULE_OVERTIME=false
WORKFLOW_EMAIL_MODULE_SALARY=false
WORKFLOW_EMAIL_MODULE_EXPENSE=false
WORKFLOW_EMAIL_MODULE_EXCEPTIONAL=false
WORKFLOW_EMAIL_MODULE_SALARY_ASSIGNMENT=false
FEATURE_OT_PAYROLL_READS_PRIMARY=true
FEATURE_OT_PAYROLL_WRITES_PRIMARY=true
FEATURE_OT_PAYROLL_LOCAL_FALLBACK_ENABLED=false
FEATURE_OT_PAYROLL_MIGRATION_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_LEAVE_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_OVERTIME_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_STAFF_VISIBILITY_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_COHORT_USER_IDS=
FEATURE_HOLIDAY_GUIDANCE_COHORT_EMAILS=
MODULE_ACTIVATION_FORCE_ALL_ENABLED=false
INSPECTION_SITE_KEY=vmecc
INSPECTION_SITE_TIMEZONE=Asia/Kuala_Lumpur
INSPECTION_DUTY_CONFIRMATION_TTL_MINUTES=10
INSPECTION_DUTY_ENFORCEMENT_ENABLED=false

AI_HELPER_ENABLED=true
AI_HELPER_RATE_LIMIT_PER_MINUTE=12
AI_HELPER_TIMEOUT_SECONDS=60
AI_HELPER_MAX_MESSAGE_LENGTH=2000
AI_HELPER_HISTORY_TURNS=12
AI_HELPER_KNOWLEDGE_UPLOAD_MAX_KB=10240
AI_HELPER_MARKDOWN_UPLOAD_MAX_KB=1024
AI_HELPER_KNOWLEDGE_UPLOAD_RATE_LIMIT_PER_MINUTE=6
AI_HELPER_KNOWLEDGE_UPLOAD_IP_RATE_LIMIT_PER_MINUTE=30
AI_HELPER_KNOWLEDGE_EXTRACT_MAX_CHARACTERS=2000000
AI_HELPER_KNOWLEDGE_CHUNK_CHARACTERS=1000
AI_HELPER_KNOWLEDGE_MAX_CHUNKS_PER_ENTRY=2500
AI_HELPER_KNOWLEDGE_RETRIEVAL_LIMIT=6
AI_HELPER_KNOWLEDGE_CATALOGUE_LIMIT=250
AI_HELPER_KNOWLEDGE_STRICT_READINESS=true
AI_HELPER_KNOWLEDGE_REQUIRE_ASYNC_QUEUE=true
AI_HELPER_KNOWLEDGE_OCR_ENABLED=true
AI_HELPER_KNOWLEDGE_OCR_MIN_NATIVE_WORDS=12
AI_HELPER_KNOWLEDGE_OCR_MIN_NATIVE_CHARACTERS=100
AI_HELPER_KNOWLEDGE_MAX_PDF_PAGES=250
AI_HELPER_KNOWLEDGE_MAX_OCR_PAGES_PER_DOCUMENT=20
AI_HELPER_KNOWLEDGE_OCR_DOCUMENT_TIMEOUT_SECONDS=600
AI_HELPER_KNOWLEDGE_JOB_TIMEOUT_SECONDS=900
AI_HELPER_KNOWLEDGE_VISUAL_CONTENT_MINIMUM_RATIO=0.0005
AI_HELPER_KNOWLEDGE_VISUAL_REVIEW_MINIMUM_RATIO=0.05
AI_HELPER_KNOWLEDGE_VISUAL_REVIEW_MAXIMUM_OCR_WORDS=120
AI_HELPER_KNOWLEDGE_OCR_TEMPORARY_RETENTION_HOURS=24
AI_HELPER_KNOWLEDGE_OCR_LANGUAGES=eng+msa
AI_HELPER_KNOWLEDGE_OCR_DPI=300
AI_HELPER_KNOWLEDGE_OCR_TIMEOUT_SECONDS=120
AI_HELPER_PDFTOTEXT_BINARY=pdftotext
AI_HELPER_PDFINFO_BINARY=pdfinfo
AI_HELPER_PDFTOPPM_BINARY=pdftoppm
AI_HELPER_TESSERACT_BINARY=tesseract
AI_HELPER_KNOWLEDGE_REQUIRE_SHARED_REVIEW=true
AI_HELPER_KNOWLEDGE_MAX_ACTIVE_UPLOADS_PER_USER=100
AI_HELPER_KNOWLEDGE_MAX_UPLOAD_BYTES_PER_USER=2147483648
