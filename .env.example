# Local development template only.
# For production, start from .env.production.example and keep real secrets server-side.
APP_NAME=VMECC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:3000

# Required only when AdminUserSeeder must create the bootstrap administrator.
# Existing administrators keep their current password when this seeder is rerun.
BOOTSTRAP_ADMIN_EMAIL=azam@amiosh.com
BOOTSTRAP_ADMIN_NAME=Jang
BOOTSTRAP_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_PATH=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vmecc
DB_USERNAME=postgres
DB_PASSWORD=

# Required by destructive E2E commands. Leave blank outside an isolated test runner.
E2E_ALLOWED_DATABASE=
E2E_ALLOWED_DB_HOST=
E2E_ALLOWED_DB_USERNAME=
E2E_RUN_ID=
E2E_RUN_ROOT=
E2E_LOCK_ROOT=
E2E_DOWNLOAD_ROOT=
E2E_MINIMUM_FREE_BYTES=1073741824
E2E_APACHE_ROOT=
E2E_APACHE_PHP_MODULE=
E2E_PHP_INI_DIRECTORY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PATH=
CACHE_PREFIX=vmecc_cache_
FILESYSTEM_DISK=local
PUBLIC_UPLOADS_DISK=public
FILESYSTEM_LOCAL_ROOT=
FILESYSTEM_PUBLIC_ROOT=
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_FILES_PATH=
SESSION_COOKIE=vmecc_laravel_session
SESSION_LIFETIME=720
SESSION_REMEMBER_DAYS=30

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
WORKFLOW_EMAIL_ENABLED=false
WORKFLOW_EMAIL_MODULE_REPORT=false
WORKFLOW_EMAIL_MODULE_INSPECTION=false
WORKFLOW_EMAIL_MODULE_LEAVE=false
WORKFLOW_EMAIL_MODULE_OVERTIME=false
WORKFLOW_EMAIL_MODULE_SALARY=false
WORKFLOW_EMAIL_MODULE_EXPENSE=false
WORKFLOW_EMAIL_MODULE_EXCEPTIONAL=false
WORKFLOW_EMAIL_MODULE_SALARY_ASSIGNMENT=false
WORKFLOW_EMAIL_MODULE_TEAM=false
WORKFLOW_EMAIL_MODULE_ROSTER=false
MESSAGE_DIGEST_EMAIL_ENABLED=false
FEATURE_OT_PAYROLL_READS_PRIMARY=true
FEATURE_OT_PAYROLL_WRITES_PRIMARY=true
FEATURE_OT_PAYROLL_LOCAL_FALLBACK_ENABLED=false
FEATURE_OT_PAYROLL_MIGRATION_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_LEAVE_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_OVERTIME_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_STAFF_VISIBILITY_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_COHORT_USER_IDS=
FEATURE_HOLIDAY_GUIDANCE_COHORT_EMAILS=
MODULE_ACTIVATION_FORCE_ALL_ENABLED=false
INSPECTION_SITE_KEY=vmecc
INSPECTION_SITE_TIMEZONE=Asia/Kuala_Lumpur
INSPECTION_DUTY_CONFIRMATION_TTL_MINUTES=10
INSPECTION_DUTY_ENFORCEMENT_ENABLED=false

AI_HELPER_ENABLED=true
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_HELPER_MODEL=gpt-5.4-mini
AI_HELPER_EMBEDDING_MODEL=text-embedding-3-small

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Report image processing. libvips is preferred; ImageMagick is the supported fallback.
REPORT_IMAGE_VIPS_BINARY=
REPORT_IMAGE_MAGICK_BINARY=
REPORT_MEDIA_THUMBNAIL_MAX_DIMENSION=480
REPORT_MEDIA_THUMBNAIL_QUALITY=76
REPORT_MEDIA_MINIMUM_DISK_FREE_BYTES=1073741824
REPORT_MEDIA_TEMPORARY_USER_QUOTA_BYTES=134217728
REPORT_MEDIA_PROCESSING_LOCK_SECONDS=240
REPORT_MEDIA_LEASE_HOURS=168
REPORT_MEDIA_LEASE_ABSOLUTE_DAYS=30
REPORT_MEDIA_REQUIRE_HEIC_PROCESSOR=true
REPORT_MEDIA_DRILL_UPLOAD_ENABLED=false
INSPECTION_PDF_MAX_IMAGES=20
INSPECTION_PDF_MAX_IMAGE_BYTES=2097152
INSPECTION_PDF_MAX_TOTAL_IMAGE_BYTES=12582912
INSPECTION_PDF_MAX_IMAGE_PIXELS=16000000
INSPECTION_SESSION_FIRE_EXTINGUISHER_ENABLED=true
INSPECTION_SESSION_SCOPE_V2_ENABLED=true
INSPECTION_SITE_KEY=vmecc
