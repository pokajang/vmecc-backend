AI_HELPER_KNOWLEDGE_FAILED_RETENTION_DAYS=14
AI_HELPER_HISTORY_MAX_CHARACTERS=12000
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_HELPER_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Report image processing. libvips is preferred; ImageMagick is the supported fallback.
REPORT_IMAGE_VIPS_BINARY=
REPORT_IMAGE_MAGICK_BINARY=
REPORT_MEDIA_THUMBNAIL_MAX_DIMENSION=480
REPORT_MEDIA_THUMBNAIL_QUALITY=76
REPORT_MEDIA_MINIMUM_DISK_FREE_BYTES=1073741824
REPORT_MEDIA_TEMPORARY_USER_QUOTA_BYTES=134217728
REPORT_MEDIA_PROCESSING_LOCK_SECONDS=240
REPORT_MEDIA_LEASE_HOURS=168
REPORT_MEDIA_LEASE_ABSOLUTE_DAYS=30
REPORT_MEDIA_REQUIRE_HEIC_PROCESSOR=true
REPORT_MEDIA_DRILL_UPLOAD_ENABLED=false
