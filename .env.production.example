APP_NAME=VMECC
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_SERVER_APP_KEY
APP_DEBUG=false
APP_URL=https://vmecc-api.amiosh.com
APP_FRONTEND_URL=https://vmecc.amiosh.com

# Leave the password empty when the administrator already exists. For first-time
# creation, set a temporary 12+ character value and remove it after seeding.
BOOTSTRAP_ADMIN_EMAIL=azam@amiosh.com
BOOTSTRAP_ADMIN_NAME=Jang
BOOTSTRAP_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=REPLACE_WITH_PRODUCTION_DATABASE
DB_USERNAME=REPLACE_WITH_PRODUCTION_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
PUBLIC_UPLOADS_DISK=public
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=960
AI_HELPER_KNOWLEDGE_REQUIRE_ASYNC_QUEUE=true
AI_HELPER_KNOWLEDGE_UPLOAD_RATE_LIMIT_PER_MINUTE=6
AI_HELPER_KNOWLEDGE_UPLOAD_IP_RATE_LIMIT_PER_MINUTE=30
AI_HELPER_KNOWLEDGE_OCR_ENABLED=true
AI_HELPER_KNOWLEDGE_OCR_MIN_NATIVE_WORDS=12
AI_HELPER_KNOWLEDGE_OCR_MIN_NATIVE_CHARACTERS=100
AI_HELPER_KNOWLEDGE_OCR_LANGUAGES=eng+msa
AI_HELPER_KNOWLEDGE_EXTRACT_MAX_CHARACTERS=2000000
AI_HELPER_KNOWLEDGE_MAX_CHUNKS_PER_ENTRY=2500
AI_HELPER_KNOWLEDGE_MAX_PDF_PAGES=250
AI_HELPER_KNOWLEDGE_MAX_OCR_PAGES_PER_DOCUMENT=20
AI_HELPER_KNOWLEDGE_OCR_DOCUMENT_TIMEOUT_SECONDS=600
AI_HELPER_KNOWLEDGE_JOB_TIMEOUT_SECONDS=900
AI_HELPER_KNOWLEDGE_VISUAL_CONTENT_MINIMUM_RATIO=0.0005
AI_HELPER_KNOWLEDGE_VISUAL_REVIEW_MINIMUM_RATIO=0.05
AI_HELPER_KNOWLEDGE_VISUAL_REVIEW_MAXIMUM_OCR_WORDS=120
AI_HELPER_KNOWLEDGE_OCR_TEMPORARY_RETENTION_HOURS=24
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_REMEMBER_DAYS=30
SESSION_DOMAIN=.amiosh.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=vmecc.amiosh.com
CORS_ALLOWED_ORIGINS=https://vmecc.amiosh.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@amiosh.com
MAIL_FROM_NAME="${APP_NAME}"
LEAVE_EMAIL_ENABLED=false
WORKFLOW_EMAIL_ENABLED=false
WORKFLOW_EMAIL_MODULE_LEAVE=false
WORKFLOW_EMAIL_MODULE_OVERTIME=false
WORKFLOW_EMAIL_MODULE_SALARY=false
WORKFLOW_EMAIL_MODULE_EXPENSE=false
WORKFLOW_EMAIL_MODULE_EXCEPTIONAL=false
WORKFLOW_EMAIL_MODULE_SALARY_ASSIGNMENT=false
WORKFLOW_EMAIL_MODULE_TEAM=false
WORKFLOW_EMAIL_MODULE_ROSTER=false

FEATURE_OT_PAYROLL_READS_PRIMARY=true
FEATURE_OT_PAYROLL_WRITES_PRIMARY=true
FEATURE_OT_PAYROLL_LOCAL_FALLBACK_ENABLED=false
FEATURE_OT_PAYROLL_MIGRATION_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_LEAVE_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_OVERTIME_ENABLED=true
FEATURE_HOLIDAY_GUIDANCE_STAFF_VISIBILITY_ENABLED=false
FEATURE_HOLIDAY_GUIDANCE_COHORT_USER_IDS=
FEATURE_HOLIDAY_GUIDANCE_COHORT_EMAILS=
MODULE_ACTIVATION_FORCE_ALL_ENABLED=false

REPORT_MEDIA_LEASE_HOURS=168
REPORT_MEDIA_LEASE_ABSOLUTE_DAYS=30
REPORT_MEDIA_DRILL_UPLOAD_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
INSPECTION_SESSION_FIRE_EXTINGUISHER_ENABLED=true
INSPECTION_SESSION_SCOPE_V2_ENABLED=true
INSPECTION_SITE_KEY=vmecc
INSPECTION_SITE_TIMEZONE=Asia/Kuala_Lumpur
INSPECTION_DUTY_CONFIRMATION_TTL_MINUTES=10
INSPECTION_DUTY_ENFORCEMENT_ENABLED=false
